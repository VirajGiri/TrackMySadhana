<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (android:dataExtractionRules).
    Controls both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="sadhana_tracker.db" />
        <include domain="database" path="sadhana_tracker.db-shm" />
        <include domain="database" path="sadhana_tracker.db-wal" />
        <include domain="sharedpref" path="." />
        <exclude domain="cache"     path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="sadhana_tracker.db" />
        <include domain="database" path="sadhana_tracker.db-shm" />
        <include domain="database" path="sadhana_tracker.db-wal" />
        <include domain="sharedpref" path="." />
        <exclude domain="cache"     path="." />
    </device-transfer>
</data-extraction-rules>

