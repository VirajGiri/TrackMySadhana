    <!-- 270° -->
    <path android:fillColor="#FFC107"
        android:pathData="M24,50 A4,4,0,1,1,23.99,50 Z" />
    <!-- 300° -->
    <path android:fillColor="#FFC107"
        android:pathData="M28,35 A4,4,0,1,1,27.99,35 Z" />
    <!-- 330° -->
    <path android:fillColor="#FFC107"
        android:pathData="M39,24 A4,4,0,1,1,38.99,24 Z" />

