    <path android:fillColor="#FFF59D"
        android:pathData="M54,54 Q50,49 54,44 Q58,49 54,54 Z" />
    <!-- Petal 2 — upper-right 60° (tip 62.7,49) -->
    <path android:fillColor="#FFF59D"
        android:pathData="M54,54 Q55,50 62.7,49 Q61,53 54,54 Z" />
    <!-- Petal 3 — lower-right 120° (tip 62.7,59) -->
    <path android:fillColor="#FFF59D"
        android:pathData="M54,54 Q61,55 62.7,59 Q58,59 54,54 Z" />
    <!-- Petal 4 — pointing down  (tip 54,64) -->
    <path android:fillColor="#FFF59D"
        android:pathData="M54,54 Q58,59 54,64 Q50,59 54,54 Z" />
