<!--
    App Icon Foreground — Mala Bead Ring with Lotus Centre
    Canvas: 108×108 dp  |  Safe zone: ~66×66 centred at (54,54)

    Ring centre: (54,54), cord radius: 30
    Bead positions (every 30°, clockwise from 12 o'clock):
      0°→(54,24)  30°→(69,28)  60°→(80,39)  90°→(84,54)
     120°→(80,69) 150°→(69,80) 180°→(54,84) 210°→(39,80)
     240°→(28,69) 270°→(24,54) 300°→(28,39) 330°→(39,28)

    Circle helper: M{cx},{cy-r} A{r},{r},0,1,1,{cx-0.01},{cy-r} Z
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── Mala cord (thin cream donut, outer r=31 inner r=29) ── -->
    <path
        android:fillColor="#FFECB3"
        android:fillType="evenOdd"
        android:pathData="
            M54,23 A31,31,0,1,1,53.99,23 Z
            M54,25 A29,29,0,1,1,53.99,25 Z" />

    <!-- ── 11 gold beads (r=4) ── -->
