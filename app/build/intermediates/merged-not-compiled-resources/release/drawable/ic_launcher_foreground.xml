    <path android:fillColor="#FFC107"
        android:pathData="M69,24 A4,4,0,1,1,68.99,24 Z" />
    <!-- 60° -->
    <path android:fillColor="#FFC107"
        android:pathData="M80,35 A4,4,0,1,1,79.99,35 Z" />
    <!-- 90° -->
    <path android:fillColor="#FFC107"
        android:pathData="M84,50 A4,4,0,1,1,83.99,50 Z" />
    <!-- 120° -->
    <path android:fillColor="#FFC107"
        android:pathData="M80,65 A4,4,0,1,1,79.99,65 Z" />
    <!-- 150° -->
    <path android:fillColor="#FFC107"
        android:pathData="M69,76 A4,4,0,1,1,68.99,76 Z" />
    <!-- 180° -->
    <path android:fillColor="#FFC107"
        android:pathData="M54,80 A4,4,0,1,1,53.99,80 Z" />
    <!-- 210° -->
    <path android:fillColor="#FFC107"
        android:pathData="M39,76 A4,4,0,1,1,38.99,76 Z" />
    <!-- 240° -->
    <path android:fillColor="#FFC107"
